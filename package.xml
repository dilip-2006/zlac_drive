<?xml version="1.0"?>

<package format="3">

  <name>zlac_drive</name>
  <version>0.1.0</version>

  <description>
    Reusable ROS 2 ros2_control hardware driver for ZLAC motor controllers
    using RS-485 and Modbus RTU communication.
  </description>

  <maintainer email="letsmaildilip@gmail.com">
    dilipkumar
  </maintainer>

  <license>Apache-2.0</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 dependencies -->
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>

  <!-- Tests -->
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>